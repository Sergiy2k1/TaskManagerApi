{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ",
        "UseUtcTimestamp": true
      }
    }
  },

  "AllowedHosts": "*",

  "Jwt": {
    "Issuer": "TaskManager.Api",
    "Audience": "TaskManager.Client",
    "AccessTokenLifetimeMinutes": 15
  }
}
