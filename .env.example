# Optional overrides for local Docker Compose development.
# Docker Compose has development-only defaults, so "docker compose up" also
# works without this file. Copy this file to .env when you want custom values.

POSTGRES_DB=task_manager
POSTGRES_USER=postgres
POSTGRES_PASSWORD=taskmanager_dev_password
POSTGRES_PORT=5432

API_PORT=5135

JWT_ISSUER=TaskManager.Api
JWT_AUDIENCE=TaskManager.Client
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15

# Base64-encoded development-only key (46 decoded bytes).
# Replace it outside local development.
JWT_SIGNING_KEY=VGFza01hbmFnZXItbG9jYWwtZGV2ZWxvcG1lbnQtc2lnbmluZy1rZXktMjAyNg==
